<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MoonInternet.Desktop.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- Palette carried over from the WPF build, same hex values. -->
        <Color x:Key="WinBgColor">#0D0A18</Color>
        <Color x:Key="AccentColor">#9D7BFF</Color>

        <SolidColorBrush x:Key="WinBg" Color="#0D0A18" />
        <SolidColorBrush x:Key="TitleBar" Color="#0A0814" />
        <SolidColorBrush x:Key="SidebarBg" Color="#0A0814" />
        <SolidColorBrush x:Key="Card" Color="#181229" />
        <SolidColorBrush x:Key="CardHover" Color="#221A3A" />
        <SolidColorBrush x:Key="HomeCard" Color="#150B30" />
        <SolidColorBrush x:Key="ChipBg" Color="#1B1530" />
        <SolidColorBrush x:Key="BorderSoft" Color="#2C2545" />
        <SolidColorBrush x:Key="Accent" Color="#9D7BFF" />
        <SolidColorBrush x:Key="AccentText" Color="#B9A7FF" />
        <SolidColorBrush x:Key="Green" Color="#34D399" />
        <SolidColorBrush x:Key="Danger" Color="#FF6B8A" />
        <SolidColorBrush x:Key="TextPrimary" Color="#ECE9F5" />
        <SolidColorBrush x:Key="TextSecondary" Color="#9A93B5" />
        <SolidColorBrush x:Key="TextMuted" Color="#6E6790" />
        <SolidColorBrush x:Key="SectionLabel" Color="#7C74A0" />

        <!-- Night-sky gradient behind the connect button. -->
        <LinearGradientBrush x:Key="HomeGradient" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#2A1466" Offset="0.0" />
            <GradientStop Color="#1A0B44" Offset="0.42" />
            <GradientStop Color="#12082E" Offset="1.0" />
        </LinearGradientBrush>

        <!-- Nav icons as geometry: the WPF build used a Windows-only symbol font. -->
        <StreamGeometry x:Key="ServersIcon">M4,4 H20 V9 H4 Z M4,11 H20 V16 H4 Z M6,6.5 H8 M6,13.5 H8</StreamGeometry>
        <StreamGeometry x:Key="SettingsIcon">M12,8 A4,4 0 1,0 12,16 A4,4 0 1,0 12,8 Z M12,2 L13.5,5 L16.5,4 L16,7 L19,7.5 L17,10 L20,12 L17,14 L19,16.5 L16,17 L16.5,20 L13.5,19 L12,22 L10.5,19 L7.5,20 L8,17 L5,16.5 L7,14 L4,12 L7,10 L5,7.5 L8,7 L7.5,4 L10.5,5 Z</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://MoonInternet/Styles/Moon.axaml" />
    </Application.Styles>

</Application>
