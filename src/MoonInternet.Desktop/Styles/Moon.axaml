<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The shared control styles from the WPF App.xaml, translated to Avalonia selectors.
        Same sizes and colours, so views ported from the desktop XAML line up without re-tuning.
    -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{StaticResource WinBg}" />
        <Setter Property="FontFamily" Value="Comic Sans MS, Comic Neue, Shantell Sans, sans-serif" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- PrimaryButton: filled accent -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#B295FF" />
    </Style>

    <!-- SecondaryButton: outlined card -->
    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource CardHover}" />
    </Style>

    <!-- GlyphButton: bare icon button -->
    <Style Selector="Button.glyph">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.glyph:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#12FFFFFF" />
    </Style>

    <!-- Card: the rounded panel every group sits in -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{StaticResource Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!-- Badge: the small protocol/transport tag -->
    <Style Selector="Border.badge">
        <Setter Property="Background" Value="{StaticResource ChipBg}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>

    <!-- Chip: selectable filter pill -->
    <Style Selector="RadioButton.chip">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="b" CornerRadius="14" Background="{StaticResource ChipBg}" Padding="12,6">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Foreground="{StaticResource TextSecondary}"
                                      FontSize="12.5" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.chip:checked /template/ Border#b">
        <Setter Property="Background" Value="#409D7BFF" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="RadioButton.chip:checked /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{StaticResource AccentText}" />
    </Style>

    <!-- SegButton: the Прокси / TUN switch -->
    <Style Selector="RadioButton.seg">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="b" CornerRadius="8" Background="Transparent" Padding="28,7">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Foreground="{StaticResource TextSecondary}"
                                      FontSize="13" HorizontalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.seg:checked /template/ Border#b">
        <Setter Property="Background" Value="#2E9D7BFF" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="RadioButton.seg:checked /template/ ContentPresenter">
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>

    <!-- DarkTextBox -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource ChipBg}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="CaretBrush" Value="{StaticResource TextPrimary}" />
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>

    <!-- Switch: ToggleSwitch tinted to the palette -->
    <Style Selector="ToggleSwitch">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
    </Style>

    <!-- Scrollbars: thin and themed, the WPF build has custom ones too -->
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
    </Style>

</Styles>
