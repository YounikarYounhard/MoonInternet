<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MoonInternet.Desktop.ViewModels"
             x:Class="MoonInternet.Desktop.Views.HomeView"
             x:DataType="vm:MainViewModel">

    <!-- Ported from the WPF HomeView: mode switch, moon button, selected server,
         connection check, the 3-column stats block, then the subscription list. -->
    <Border Background="{StaticResource HomeGradient}">
        <Grid Margin="16,10,16,8" RowDefinitions="Auto,Auto,Auto,*">

            <!-- mode toggle -->
            <Border Grid.Row="0" HorizontalAlignment="Center" CornerRadius="13"
                    Background="#160A34" BorderBrush="#2C2150" BorderThickness="1" Padding="3">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Classes="seg" GroupName="mode" Content="Прокси"
                                 IsChecked="{Binding ProxyMode}" />
                    <RadioButton Classes="seg" GroupName="mode" Content="TUN"
                                 IsChecked="{Binding TunMode}" />
                </StackPanel>
            </Border>

            <!-- connect hero -->
            <StackPanel Grid.Row="1" Margin="0,10,0,2" HorizontalAlignment="Center">
                <Button Command="{Binding ConnectCommand}" Background="Transparent"
                        BorderThickness="0" Padding="0" Cursor="Hand"
                        HorizontalAlignment="Center">
                    <Panel Width="204" Height="204">
                        <Ellipse Width="198" Height="198" StrokeThickness="1.5"
                                 Stroke="White" Opacity="0.22" />
                        <Image Source="{Binding MoonImage}" Width="172" Height="172"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                </Button>

                <TextBlock Text="{Binding StateText}" HorizontalAlignment="Center"
                           FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0" />

                <!-- selected server -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"
                            IsVisible="{Binding HasSelectedServer}">
                    <Image Source="{Binding SelectedServerFlag}" Width="20" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="{Binding SelectedServerLabel}" Foreground="{StaticResource AccentText}"
                               FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="330" />
                </StackPanel>

                <!-- check connection + ping -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0"
                            IsVisible="{Binding IsConnected}">
                    <Button Classes="secondary" Command="{Binding CheckConnectionCommand}" Padding="18,7">
                        <TextBlock Text="Проверить соединение" />
                    </Button>
                    <Border IsVisible="{Binding HasCheckPing}" VerticalAlignment="Center"
                            Margin="8,0,0,0" CornerRadius="9" Background="#2534D399" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource Green}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CheckPingText}" Foreground="{StaticResource Green}"
                                       FontSize="12.5" FontWeight="SemiBold" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- compact stats + add / paste -->
            <Grid Grid.Row="2" Margin="0,12,0,0" ColumnDefinitions="104,90,*">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,0,7">
                        <TextBlock Text="Отдача" Foreground="{StaticResource TextSecondary}" FontSize="10.5" />
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <TextBlock Text="↑" Foreground="{StaticResource Green}" FontSize="12"
                                       FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,3,0" />
                            <TextBlock Text="{Binding UploadSpeed}" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Приём" Foreground="{StaticResource TextSecondary}" FontSize="10.5" />
                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                            <TextBlock Text="↓" Foreground="{StaticResource AccentText}" FontSize="12"
                                       FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,3,0" />
                            <TextBlock Text="{Binding DownloadSpeed}" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,0,7">
                        <TextBlock Text="Время" Foreground="{StaticResource TextSecondary}" FontSize="10.5" />
                        <TextBlock Text="{Binding ElapsedDisplay}" FontWeight="SemiBold" FontSize="13" Margin="0,1,0,0" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Трафик" Foreground="{StaticResource TextSecondary}" FontSize="10.5" />
                        <TextBlock Text="{Binding SessionTraffic}" FontWeight="SemiBold" FontSize="13" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Button Command="{Binding OpenAddDialogCommand}" Background="#2C2058" Foreground="#C4B4FF"
                            CornerRadius="10" Padding="14,9" Margin="0,0,0,6"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            BorderThickness="0" Cursor="Hand" Content="+ Добавить" FontWeight="SemiBold" FontSize="12" />
                    <Button Command="{Binding PasteImportCommand}" Background="{StaticResource ChipBg}"
                            Foreground="#C6CAD3" CornerRadius="10" Padding="14,9"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            BorderThickness="0" Cursor="Hand" Content="Вставить" FontWeight="SemiBold" FontSize="12" />
                </StackPanel>
            </Grid>

            <!-- subscriptions -->
            <ScrollViewer Grid.Row="3" Margin="0,12,0,0" VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Subscriptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SubscriptionVM">
                                <Border Classes="card" Background="{StaticResource HomeCard}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid ColumnDefinitions="*,Auto" Margin="14,12">
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding TrafficText}" FontSize="11.5"
                                                               Foreground="{StaticResource TextSecondary}" Margin="0,0,12,0" />
                                                    <TextBlock Text="{Binding ExpiryText}" FontSize="11.5"
                                                               Foreground="{StaticResource TextSecondary}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="{StaticResource Accent}" CornerRadius="9"
                                                    Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Count}" Foreground="White"
                                                           FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding Servers}" Margin="7,0,7,7">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ServerItem">
                                                    <Border CornerRadius="12" Padding="14,11" Margin="0,3"
                                                            Background="{StaticResource Card}" Cursor="Hand">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <Image Grid.Column="0" Source="{Binding FlagImage}"
                                                                   Width="30" Margin="0,0,11,0" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Label}" FontSize="13.5"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                                    <Border Classes="badge" Background="#2E9D7BFF">
                                                                        <TextBlock Text="{Binding Protocol}" FontSize="10"
                                                                                   Foreground="{StaticResource AccentText}"
                                                                                   FontWeight="SemiBold" />
                                                                    </Border>
                                                                    <Border Classes="badge">
                                                                        <TextBlock Text="{Binding Network}" FontSize="10"
                                                                                   Foreground="{StaticResource TextSecondary}" />
                                                                    </Border>
                                                                    <Border Classes="badge" Background="#2534D399"
                                                                            IsVisible="{Binding HasSecurity}">
                                                                        <TextBlock Text="{Binding Security}" FontSize="10"
                                                                                   Foreground="{StaticResource Green}"
                                                                                   FontWeight="SemiBold" />
                                                                    </Border>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding PingText}"
                                                                       Foreground="{StaticResource TextSecondary}"
                                                                       FontSize="11.5" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Classes="card" Background="{StaticResource HomeCard}" Padding="16,14"
                            IsVisible="{Binding HasNoServers}">
                        <StackPanel>
                            <TextBlock Text="Нет подписки" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="Нажмите «Добавить» или вставьте ссылку из буфера"
                                       Foreground="{StaticResource TextSecondary}" FontSize="12"
                                       Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
