<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MoonInternet.Desktop.ViewModels"
             x:Class="MoonInternet.Desktop.Views.ServersView"
             x:DataType="vm:MainViewModel">

    <!-- Ported from the WPF ServersView: header, add/paste, search, protocol + sort chips,
         then the servers grouped by subscription. -->
    <Grid Margin="16,14,16,10" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">

        <Grid Grid.Row="0" Margin="0,2,0,12">
            <StackPanel>
                <TextBlock Text="Сервера" FontSize="21" FontWeight="Bold" />
                <TextBlock Text="{Binding TotalServersText}" Foreground="{StaticResource TextSecondary}"
                           FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Classes="glyph" Content="⟳" Command="{Binding PingAllCommand}" ToolTip.Tip="Пинговать все" />
                <Button Classes="glyph" Content="↻" Command="{Binding RefreshAllCommand}" ToolTip.Tip="Обновить подписки" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12" ColumnDefinitions="*,*">
            <Button Grid.Column="0" Classes="primary" Command="{Binding OpenAddDialogCommand}"
                    Margin="0,0,4,0" Content="+ Добавить" HorizontalAlignment="Stretch" />
            <Button Grid.Column="1" Classes="secondary" Command="{Binding PasteImportCommand}"
                    Margin="4,0,0,0" Content="Вставить" HorizontalAlignment="Stretch" />
        </Grid>

        <TextBox Grid.Row="2" Text="{Binding Search}" Watermark="Поиск серверов…" Margin="0,0,0,10" />

        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="ПРОТОКОЛ" Foreground="{StaticResource SectionLabel}" FontSize="10"
                       FontWeight="SemiBold" Margin="2,0,0,6" />
            <ItemsControl ItemsSource="{Binding FilterChips}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <RadioButton Classes="chip" GroupName="filt" Content="{Binding}" Margin="0,0,8,8" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="СОРТИРОВКА" Foreground="{StaticResource SectionLabel}" FontSize="10"
                       FontWeight="SemiBold" Margin="2,0,0,6" />
            <WrapPanel>
                <RadioButton Classes="chip" GroupName="sort" Content="Обычная" Margin="0,0,8,8"
                             Command="{Binding SetSortCommand}" CommandParameter="default" />
                <RadioButton Classes="chip" GroupName="sort" Content="↕ Пинг" Margin="0,0,8,8"
                             Command="{Binding SetSortCommand}" CommandParameter="ping" />
                <RadioButton Classes="chip" GroupName="sort" Content="А–Я" Margin="0,0,8,8"
                             Command="{Binding SetSortCommand}" CommandParameter="name" />
                <RadioButton Classes="chip" GroupName="sort" Content="★ Избранное" Margin="0,0,0,8"
                             Command="{Binding SetSortCommand}" CommandParameter="favorite" />
            </WrapPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Hidden">
            <ItemsControl ItemsSource="{Binding Subscriptions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SubscriptionVM">
                        <Border Classes="card" Background="#120C24" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto" Margin="14,12">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding TrafficText}" FontSize="11.5"
                                                       Foreground="{StaticResource TextSecondary}" Margin="0,0,12,0" />
                                            <TextBlock Text="{Binding ExpiryText}" FontSize="11.5"
                                                       Foreground="{StaticResource TextSecondary}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource Accent}" CornerRadius="9"
                                            Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Count}" Foreground="White"
                                                   FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Servers}" Margin="7,0,7,7">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ServerItem">
                                            <Border CornerRadius="12" Padding="14,11" Margin="0,3"
                                                    Background="{StaticResource Card}" Cursor="Hand">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Image Grid.Column="0" Source="{Binding FlagImage}" Width="30"
                                                           Margin="0,0,11,0" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Label}" FontSize="13.5"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                            <Border Classes="badge" Background="#2E9D7BFF">
                                                                <TextBlock Text="{Binding Protocol}" FontSize="10"
                                                                           Foreground="{StaticResource AccentText}"
                                                                           FontWeight="SemiBold" />
                                                            </Border>
                                                            <Border Classes="badge">
                                                                <TextBlock Text="{Binding Network}" FontSize="10"
                                                                           Foreground="{StaticResource TextSecondary}" />
                                                            </Border>
                                                            <Border Classes="badge" Background="#2534D399"
                                                                    IsVisible="{Binding HasSecurity}">
                                                                <TextBlock Text="{Binding Security}" FontSize="10"
                                                                           Foreground="{StaticResource Green}"
                                                                           FontWeight="SemiBold" />
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding PingText}"
                                                               Foreground="{StaticResource TextSecondary}"
                                                               FontSize="11.5" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
