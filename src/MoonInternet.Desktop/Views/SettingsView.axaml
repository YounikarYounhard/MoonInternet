<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MoonInternet.Desktop.ViewModels"
             x:Class="MoonInternet.Desktop.Views.SettingsView"
             x:DataType="vm:MainViewModel">

    <!-- Hub + sub-pages, same nine cards and the same order as the WPF SettingsView. -->
    <Grid>
        <!-- ===== HUB ===== -->
        <ScrollViewer IsVisible="{Binding IsSettingsHub}">
            <StackPanel Margin="24,20,24,24">
                <TextBlock Text="Настройки" FontSize="26" FontWeight="Bold" Margin="2,4,0,2" />
                <TextBlock Text="Moon Internet · 0.9.0 beta" Foreground="{StaticResource TextSecondary}"
                           FontSize="12.5" Margin="2,0,0,18" />

                <ItemsControl ItemsSource="{Binding SettingsHub}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HubEntry">
                            <Button Classes="secondary" Margin="0,0,0,10" Padding="15,14"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    CornerRadius="14"
                                    Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenSettingsPageCommand}"
                                    CommandParameter="{Binding Id}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Width="38" Height="38" CornerRadius="11"
                                            Background="#2C2058" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextSecondary}"
                                                   FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="›" FontSize="18"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== SUB-PAGE: header stays put, body scrolls ===== -->
        <Grid IsVisible="{Binding IsSettingsSubPage}" RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="24,20,24,16">
                <Button Classes="glyph" Content="‹" FontSize="20" Command="{Binding SettingsBackCommand}" />
                <TextBlock Text="{Binding SettingsPageTitle}" FontSize="24" FontWeight="Bold"
                           Margin="6,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <ScrollViewer Grid.Row="1">
                <StackPanel Margin="24,0,24,24">

                    <!-- Соединение -->
                    <Border Classes="card" Padding="6" IsVisible="{Binding IsPageConnection}">
                        <StackPanel>
                            <Grid Margin="12">
                                <StackPanel Margin="0,0,58,0">
                                    <TextBlock Text="Авто-переподключение" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Если ядро упало — переподключиться автоматически"
                                               Foreground="{StaticResource TextSecondary}" FontSize="12"
                                               Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding AutoReconnect}" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0" />
                            <Grid Margin="12">
                                <StackPanel Margin="0,0,58,0">
                                    <TextBlock Text="Блокировать UDP" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Сломает QUIC и голосовые звонки. Включайте, только если знаете зачем"
                                               Foreground="{StaticResource TextSecondary}" FontSize="12"
                                               Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding BlockUdp}" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0" />
                            <StackPanel Margin="12">
                                <TextBlock Text="Локальный прокси" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding LocalProxyInfo}" Foreground="{StaticResource TextSecondary}"
                                           FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Авто -->
                    <Border Classes="card" Padding="6" IsVisible="{Binding IsPageAuto}">
                        <StackPanel>
                            <Grid Margin="12">
                                <StackPanel Margin="0,0,58,0">
                                    <TextBlock Text="Автозапуск при входе" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Запускать Moon Internet вместе с системой"
                                               Foreground="{StaticResource TextSecondary}" FontSize="12"
                                               Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding Autostart}" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0" />
                            <Grid Margin="12">
                                <StackPanel Margin="0,0,58,0">
                                    <TextBlock Text="Авто-подключение при запуске" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Подключаться сразу после старта приложения"
                                               Foreground="{StaticResource TextSecondary}" FontSize="12"
                                               Margin="0,2,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding AutoConnectOnStart}" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Подписки -->
                    <Border Classes="card" Padding="6" IsVisible="{Binding IsPageSubs}">
                        <StackPanel>
                            <Grid Margin="12">
                                <StackPanel Margin="0,0,58,0">
                                    <TextBlock Text="Обновлять при запуске" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Тянуть подписки при старте приложения"
                                               Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding UpdateSubsOnStart}" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                            </Grid>
                            <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0" />
                            <Grid Margin="12">
                                <StackPanel Margin="0,0,58,0">
                                    <TextBlock Text="Пинг при запуске" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="Замерять задержку серверов после старта"
                                               Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleSwitch IsChecked="{Binding PingOnStart}" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- О приложении -->
                    <StackPanel IsVisible="{Binding IsPageAbout}">
                        <TextBlock Text="ИНФОРМАЦИЯ" Foreground="{StaticResource SectionLabel}" FontSize="10.5"
                                   FontWeight="SemiBold" Margin="4,0,0,8" />
                        <Border Classes="card">
                            <StackPanel>
                                <Grid Margin="14,11">
                                    <TextBlock Text="Версия Xray" FontSize="13.5" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding XrayVersion}" Foreground="{StaticResource AccentText}"
                                               FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource BorderSoft}" Margin="14,0" />
                                <Grid Margin="14,11">
                                    <TextBlock Text="Версия приложения" FontSize="13.5" VerticalAlignment="Center" />
                                    <TextBlock Text="0.9.0 beta" Foreground="{StaticResource AccentText}"
                                               FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>
                                <Border Height="1" Background="{StaticResource BorderSoft}" Margin="14,0" />
                                <Grid Margin="14,11">
                                    <TextBlock Text="Система" FontSize="13.5" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding OsDescription}" Foreground="{StaticResource AccentText}"
                                               FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Right"
                                               TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Остальные разделы появятся здесь по мере переноса -->
                    <Border Classes="card" Padding="16,14" IsVisible="{Binding IsPagePlaceholder}">
                        <TextBlock Text="Раздел переносится с ПК-версии." TextWrapping="Wrap"
                                   Foreground="{StaticResource TextSecondary}" FontSize="13" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
