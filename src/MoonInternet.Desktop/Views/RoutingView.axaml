<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:MoonInternet.Desktop.ViewModels"
             x:Class="MoonInternet.Desktop.Views.RoutingView"
             x:DataType="vm:MainViewModel">

    <!-- Ported from the WPF RoutingView: geo files, profile picker, search, three rule buckets. -->
    <Grid Margin="24,20,24,12" RowDefinitions="Auto,*">

        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                <Button Classes="glyph" Content="‹" FontSize="20" Command="{Binding BackToRoutingSettingsCommand}" />
                <TextBlock Text="Маршрутизация" FontSize="24" FontWeight="Bold" Margin="6,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!-- geo files -->
            <Border Classes="card" Padding="14,12" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Гео-файлы" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Classes="glyph" Content="↻" HorizontalAlignment="Right"
                                Command="{Binding RefreshGeoCommand}" ToolTip.Tip="Обновить гео-файлы" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <TextBlock Text="geoip.dat" FontSize="12.5" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GeoipInfo}" Foreground="{StaticResource TextSecondary}"
                                   FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="1" Background="{StaticResource BorderSoft}" Margin="0,8" />
                    <Grid>
                        <TextBlock Text="geosite.dat" FontSize="12.5" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GeositeInfo}" Foreground="{StaticResource TextSecondary}"
                                   FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding GeoStatus}" Foreground="{StaticResource AccentText}"
                               FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- profile source -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Профиль:" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <Border CornerRadius="10" Background="{StaticResource Card}"
                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="3">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Classes="seg" GroupName="routingsel" Content="INCY"
                                     Command="{Binding SelectRoutingSourceCommand}" CommandParameter="incy" />
                        <RadioButton Classes="seg" GroupName="routingsel" Content="HAPP"
                                     Command="{Binding SelectRoutingSourceCommand}" CommandParameter="happ" />
                        <RadioButton Classes="seg" GroupName="routingsel" Content="Свой"
                                     Command="{Binding SelectRoutingSourceCommand}" CommandParameter="custom" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <TextBox Text="{Binding RuleSearch}" Watermark="Поиск по правилам…" Margin="0,0,0,10" />

                <ItemsControl ItemsSource="{Binding RuleBuckets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:RuleBucket">
                            <Border Classes="card" Padding="14,12" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Foreground="{Binding Tint}"
                                                       FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                            <Border CornerRadius="8" Background="#1EFFFFFF" Padding="7,1"
                                                    Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextMuted}"
                                               FontSize="11" Margin="0,2,0,0" />
                                    <ItemsControl ItemsSource="{Binding Rules}" Margin="0,10,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <Border Background="#1EFFFFFF" CornerRadius="7" Padding="8,3" Margin="0,0,6,6">
                                                    <TextBlock Text="{Binding}" FontSize="11.5"
                                                               TextTrimming="CharacterEllipsis" MaxWidth="300" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
