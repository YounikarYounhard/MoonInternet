<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MoonInternet.Core\MoonInternet.Core.csproj" />
    <ProjectReference Include="..\MoonInternet.Services\MoonInternet.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
