    <Resource Include="Assets\moon_off.png" />
    <Resource Include="Assets\moon44.png" />
    <Resource Include="Assets\reference.png" />
    <Resource Include="Assets\btn_off.png" />
    <Resource Include="Assets\btn_on.png" />
    <Resource Include="Assets\nav.png" />
    <Resource Include="Assets\flags\*.png" />
  </ItemGroup>

</Project>
