                    <RadioButton Style="{StaticResource Chip}" GroupName="pingdisp" Content="Шкала" Margin="0,0,8,8" Command="{Binding SetPingDisplayCommand}" CommandParameter="bar" IsChecked="{Binding IsPingDispBar, Mode=OneWay}"/>
                    <RadioButton Style="{StaticResource Chip}" GroupName="pingdisp" Content="Оба" Margin="0,0,8,8" Command="{Binding SetPingDisplayCommand}" CommandParameter="both" IsChecked="{Binding IsPingDispBoth, Mode=OneWay}"/>
                    <RadioButton Style="{StaticResource Chip}" GroupName="pingdisp" Content="Точки" Margin="0,0,0,8" Command="{Binding SetPingDisplayCommand}" CommandParameter="dots" IsChecked="{Binding IsPingDispDots, Mode=OneWay}"/>
                </WrapPanel>

                <TextBlock Text="ТЕСТОВЫЙ URL" Foreground="{StaticResource SectionLabel}" FontSize="10.5" FontWeight="SemiBold" Margin="4,14,0,8"/>
                <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding PingTestUrl, UpdateSourceTrigger=LostFocus}"/>
                <TextBlock Text="Пресеты" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="2,10,0,6"/>
                <WrapPanel>
                    <Button Style="{StaticResource SecondaryButton}" Content="Google 204" Padding="12,7" Margin="0,0,8,8" Command="{Binding SetPingUrlCommand}" CommandParameter="https://www.gstatic.com/generate_204"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Cloudflare" Padding="12,7" Margin="0,0,8,8" Command="{Binding SetPingUrlCommand}" CommandParameter="https://cp.cloudflare.com/generate_204"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="Apple" Padding="12,7" Margin="0,0,0,8" Command="{Binding SetPingUrlCommand}" CommandParameter="https://captive.apple.com"/>
                </WrapPanel>
                <TextBlock Text="Используется для HTTP GET / HEAD. Moon Ping и TCP проверяют сам сервер." Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="4,0,0,14" TextWrapping="Wrap"/>

                <TextBlock Text="ТАЙМ-АУТ" Foreground="{StaticResource SectionLabel}" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,0,8"/>
                <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="16,12">
                    <Grid>
                        <!-- The stepper sits on the right, so the label has to stop before it —
                             without this margin the description ran underneath the value pill. -->
                        <StackPanel VerticalAlignment="Center" Margin="0,0,152,0">
                            <TextBlock Text="Тайм-аут пинга" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="Максимальное время ожидания ответа" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource GlyphButton}" Content="&#xE738;" Command="{Binding PingTimeoutDecCommand}" ToolTip="Меньше"/>
                            <!-- Fixed width, not MinWidth: the pill grew with the number, so the
                                 minus and plus buttons shifted sideways as the value changed and
                                 nothing stayed put. -->
                            <Border CornerRadius="8" Background="#2C2058" Padding="0,5" Margin="6,0" Width="64">
                                <TextBlock Text="{Binding PingTimeoutText}" Foreground="{StaticResource AccentText}" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>
                            </Border>
                            <Button Style="{StaticResource GlyphButton}" Content="&#xE710;" Command="{Binding PingTimeoutIncCommand}" ToolTip="Больше"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="PageScroll_PreviewMouseWheel"
                      Visibility="{Binding SettingsPage, Converter={StaticResource EnumVis}, ConverterParameter=logs}">
            <StackPanel Margin="24,20,24,24">

                <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="6">
                    <StackPanel>
                        <Grid Margin="12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="Вести логи" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Записывать журналы ядра для диагностики" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LogsEnabled}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Visibility="{Binding LogsEnabled, Converter={StaticResource BoolVis}}">
                            <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                            <StackPanel Margin="12">
                                <TextBlock Text="Уровень" FontSize="14" FontWeight="SemiBold"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="loglvl" Content="Ошибки" Margin="0,0,8,8" Command="{Binding SetLogLevelCommand}" CommandParameter="error" IsChecked="{Binding IsLogErr, Mode=OneWay}"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="loglvl" Content="Предупреждения" Margin="0,0,8,8" Command="{Binding SetLogLevelCommand}" CommandParameter="warn" IsChecked="{Binding IsLogWarn, Mode=OneWay}"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="loglvl" Content="Инфо" Margin="0,0,8,8" Command="{Binding SetLogLevelCommand}" CommandParameter="info" IsChecked="{Binding IsLogInfo, Mode=OneWay}"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="loglvl" Content="Отладка" Margin="0,0,0,8" Command="{Binding SetLogLevelCommand}" CommandParameter="debug" IsChecked="{Binding IsLogDebug, Mode=OneWay}"/>
                                </WrapPanel>
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                            <StackPanel Margin="12">
                                <TextBlock Text="Сколько хранить логи" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Старые записи удаляются автоматически при запуске" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="logkeep" Content="1 день" Margin="0,0,8,8" Command="{Binding SetLogKeepCommand}" CommandParameter="1" IsChecked="{Binding IsKeep1, Mode=OneWay}"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="logkeep" Content="3 дня" Margin="0,0,8,8" Command="{Binding SetLogKeepCommand}" CommandParameter="3" IsChecked="{Binding IsKeep3, Mode=OneWay}"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="logkeep" Content="7 дней" Margin="0,0,8,8" Command="{Binding SetLogKeepCommand}" CommandParameter="7" IsChecked="{Binding IsKeep7, Mode=OneWay}"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="logkeep" Content="30 дней" Margin="0,0,8,8" Command="{Binding SetLogKeepCommand}" CommandParameter="30" IsChecked="{Binding IsKeep30, Mode=OneWay}"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="logkeep" Content="Всегда" Margin="0,0,0,8" Command="{Binding SetLogKeepCommand}" CommandParameter="0" IsChecked="{Binding IsKeepForever, Mode=OneWay}"/>
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <Grid Margin="12">
                            <TextBlock Text="Размер логов" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LogsSizeInfo}" Foreground="{StaticResource AccentText}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenLogsFolderCommand}" Content="Открыть папку" Padding="14,8"/>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ClearLogsCommand}" Content="Очистить логи" Padding="14,8" Margin="8,0,0,0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= ПОЛИТИКА КОНФИДЕНЦИАЛЬНОСТИ ================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="PageScroll_PreviewMouseWheel"
                      Visibility="{Binding SettingsPage, Converter={StaticResource EnumVis}, ConverterParameter=privacy}">
            <StackPanel Margin="24,20,24,24">

                <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="18,16">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                                   Text="Moon Internet — локальный VPN-клиент. Ниже — как приложение обращается с вашими данными."/>

                        <TextBlock Text="Мы не собираем данные" FontWeight="SemiBold" FontSize="14" Margin="0,16,0,4"/>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                                   Text="Приложение работает на вашем устройстве. Разработчик не получает ваши данные: нет аккаунтов, телеметрии, аналитики и обращений «домой»."/>

                        <TextBlock Text="Данные на устройстве" FontWeight="SemiBold" FontSize="14" Margin="0,14,0,4"/>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                                   Text="Подписки, список серверов, ключи и пароли доступа хранятся локально в папке приложения (папка «save») и не покидают ваш компьютер. Удаление приложения удаляет их."/>

                        <TextBlock Text="Ваш трафик" FontWeight="SemiBold" FontSize="14" Margin="0,14,0,4"/>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                                   Text="Трафик идёт через серверы, которые вы добавили сами (по ссылке-подписке). Их операторы обрабатывают трафик по своим правилам — ознакомьтесь с их политикой. Само приложение ваш трафик не логирует и никуда не пересылает."/>

                        <TextBlock Text="Сетевые обращения" FontWeight="SemiBold" FontSize="14" Margin="0,14,0,4"/>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                                   Text="Приложение обращается только к: (1) вашим URL-подпискам — чтобы получить список серверов; (2) источникам гео-правил (например, GitHub) — чтобы скачать файлы маршрутизации, если включён роутинг. Больше никуда."/>

                        <TextBlock Text="Логи" FontWeight="SemiBold" FontSize="14" Margin="0,14,0,4"/>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                                   Text="Технические логи для диагностики соединения хранятся локально и не отправляются. Их можно открыть в разделе «Логи»."/>

                        <TextBlock Text="Права" FontWeight="SemiBold" FontSize="14" Margin="0,14,0,4"/>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                                   Text="Режим TUN требует прав администратора (системная служба туннеля). Она нужна только для маршрутизации трафика и не собирает данные."/>

                        <TextBlock Text="Изменения" FontWeight="SemiBold" FontSize="14" Margin="0,14,0,4"/>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                                   Text="Политика может обновляться вместе с приложением."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= О ПРИЛОЖЕНИИ ================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="PageScroll_PreviewMouseWheel"
                      Visibility="{Binding SettingsPage, Converter={StaticResource EnumVis}, ConverterParameter=about}">
            <StackPanel Margin="24,20,24,24">

                <TextBlock Text="ИНФОРМАЦИЯ" Foreground="{StaticResource SectionLabel}" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,0,8"/>
                <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="14,11">
                            <TextBlock Text="Версия Xray" FontSize="13.5" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding XrayVersion}" Foreground="{StaticResource AccentText}" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="14,0"/>
                        <Grid Margin="14,11">
                            <TextBlock Text="Версия sing-box" FontSize="13.5" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SingBoxVersion}" Foreground="{StaticResource AccentText}" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="14,0"/>
                        <Grid Margin="14,11">
                            <TextBlock Text="Версия приложения" FontSize="13.5" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding AppVersion}" Foreground="{StaticResource AccentText}" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="ССЫЛКИ" Foreground="{StaticResource SectionLabel}" FontSize="10.5" FontWeight="SemiBold" Margin="4,18,0,8"/>
                <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                    <StackPanel>
                        <Button Style="{StaticResource NavRow}" Content="Условия использования" Command="{Binding OpenSettingsPageCommand}" CommandParameter="terms"/>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="14,0"/>
                        <Button Style="{StaticResource NavRow}" Content="Политика конфиденциальности" Command="{Binding OpenSettingsPageCommand}" CommandParameter="privacy"/>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="14,0"/>
                        <Button Style="{StaticResource NavRow}" Content="Сторонние библиотеки" Command="{Binding OpenSettingsPageCommand}" CommandParameter="libs"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Это приложение — только прокси-инструмент. Мы не собираем персональные данные и не предоставляем прокси-услуги."
                           Foreground="{StaticResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" Margin="10,12,10,0"/>

                <TextBlock Text="СИСТЕМА" Foreground="{StaticResource SectionLabel}" FontSize="10.5" FontWeight="SemiBold" Margin="4,18,0,8"/>
                <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="14,11">
                            <TextBlock Text="Платформа" FontSize="13.5" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding OsPlatform}" Foreground="{StaticResource AccentText}" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="14,0"/>
                        <Grid Margin="14,11">
                            <TextBlock Text="Архитектура" FontSize="13.5" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding OsArch}" Foreground="{StaticResource AccentText}" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="14,0"/>
                        <Grid Margin="14,11">
                            <TextBlock Text=".NET" FontSize="13.5" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DotNetVersion}" Foreground="{StaticResource AccentText}" FontSize="13.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="14,0"/>
                        <Grid Margin="14,11">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="HWID" FontSize="13.5" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding HwidDisplay}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,6,0" TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="2" Style="{StaticResource GlyphButton}" Content="&#xE8C8;" Command="{Binding CopyHwidCommand}" ToolTip="Скопировать HWID"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= УСЛОВИЯ ИСПОЛЬЗОВАНИЯ ================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="PageScroll_PreviewMouseWheel"
                      Visibility="{Binding SettingsPage, Converter={StaticResource EnumVis}, ConverterParameter=terms}">
            <StackPanel Margin="24,20,24,24">
                <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="18,16">
                    <StackPanel>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" LineHeight="20"
                                   Text="Moon Internet предоставляется «как есть», без каких-либо гарантий. Приложение — только инструмент для подключения к прокси/VPN-серверам, которые вы добавляете сами."/>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,0"
                                   Text="Вы сами отвечаете за серверы и подписки, которые используете, и за соблюдение законов вашей страны. Разработчик не предоставляет прокси-услуги и не несёт ответственности за содержимое трафика."/>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="13" TextWrapping="Wrap" LineHeight="20" Margin="0,12,0,0"
                                   Text="Используя приложение, вы соглашаетесь с этими условиями."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= СТОРОННИЕ БИБЛИОТЕКИ ================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="PageScroll_PreviewMouseWheel"
                      Visibility="{Binding SettingsPage, Converter={StaticResource EnumVis}, ConverterParameter=libs}">
            <StackPanel Margin="24,20,24,24">
                <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="Ядра" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12.5" LineHeight="20" TextWrapping="Wrap"
                                   Text="• xray-core — MPL-2.0&#x0a;• sing-box — GPL-3.0&#x0a;• tun2socks (hev-socks5-tunnel)&#x0a;• amneziawg-go"/>
                        <TextBlock Text="Библиотеки .NET" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,6"/>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12.5" LineHeight="20" TextWrapping="Wrap"
                                   Text="• CommunityToolkit.Mvvm — MIT&#x0a;• H.NotifyIcon.Wpf — MIT&#x0a;• QRCoder — MIT"/>
                        <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,14,0,0" TextWrapping="Wrap"
                                   Text="Полные тексты лицензий поставляются вместе с соответствующими компонентами."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
