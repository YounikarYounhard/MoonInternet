<UserControl x:Class="MoonInternet.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <UserControl.Resources>
        <!-- hub category card: icon + title + chevron -->
        <Style x:Key="HubCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="15,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="11" Background="#2C2058" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="14.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{TemplateBinding ToolTip}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- link row inside a card: label + chevron, navigates via Command/CommandParameter -->
        <Style x:Key="NavRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" Padding="14,12">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="13.5" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#12FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "coming soon" placeholder row -->
        <Style x:Key="SoonRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- pinned header -->
            <RowDefinition Height="*"/>       <!-- the pages -->
        </Grid.RowDefinitions>

        <!-- One header for every sub-page, outside the scrolling area so it stays put. It used to
             live inside each page's ScrollViewer and scrolled away with the content, which left
             no way back without scrolling to the top first. The hub keeps its own big title. -->
        <Border Grid.Row="0" Background="{StaticResource WinBg}" Padding="24,18,24,12"
                Visibility="{Binding IsSettingsSubPage, Converter={StaticResource BoolVis}}"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GlyphButton}" Content="&#xE72B;" Command="{Binding SettingsBackCommand}" ToolTip="{DynamicResource S_SettingsView_001}"/>
                <TextBlock Text="{Binding SettingsPageTitle}" FontSize="22" FontWeight="Bold" Margin="6,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
        <!-- ================= HUB ================= -->
        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding SettingsPage, Converter={StaticResource EnumVis}, ConverterParameter=hub}">
            <StackPanel Margin="24,20,24,24">
                <!-- Title on the left, language on the right at the same height, as asked. -->
                <Grid Margin="0,4,0,2">
                    <TextBlock Text="{DynamicResource S_SettingsView_002}" FontSize="26" FontWeight="Bold" Margin="2,0,0,0"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                            Command="{Binding ToggleLanguageCommand}" ToolTip="Русский / English"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="b" CornerRadius="9" Background="{StaticResource Card}"
                                        BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="12,6">
                                    <TextBlock Text="{Binding LanguageLabel}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentText}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
                <TextBlock Text="{Binding AppVersion, StringFormat=Moon Internet · {0}}" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="2,0,0,18"/>

                <Button Style="{StaticResource HubCard}" Tag="&#xE790;" Content="{DynamicResource S_SettingsView_003}" ToolTip="{DynamicResource S_SettingsView_004}" Command="{Binding OpenSettingsPageCommand}" CommandParameter="appearance"/>
                <Button Style="{StaticResource HubCard}" Tag="&#xE839;" Content="{DynamicResource S_SettingsView_005}" ToolTip="{DynamicResource S_SettingsView_006}" Command="{Binding OpenSettingsPageCommand}" CommandParameter="connection"/>
                <Button Style="{StaticResource HubCard}" Tag="&#xE71B;" Content="{DynamicResource S_SettingsView_007}" ToolTip="{DynamicResource S_SettingsView_008}" Command="{Binding OpenSettingsPageCommand}" CommandParameter="routing"/>
                <Button Style="{StaticResource HubCard}" Tag="&#xE8F1;" Content="{DynamicResource S_SettingsView_009}" ToolTip="{DynamicResource S_SettingsView_010}" Command="{Binding OpenSettingsPageCommand}" CommandParameter="subs"/>
                <Button Style="{StaticResource HubCard}" Tag="&#xEC4A;" Content="{DynamicResource S_SettingsView_011}" ToolTip="{DynamicResource S_SettingsView_012}" Command="{Binding OpenSettingsPageCommand}" CommandParameter="ping"/>
                <Button Style="{StaticResource HubCard}" Tag="&#xEC92;" Content="{DynamicResource S_SettingsView_013}" ToolTip="{DynamicResource S_SettingsView_014}" Command="{Binding OpenSettingsPageCommand}" CommandParameter="auto"/>
                <Button Style="{StaticResource HubCard}" Tag="&#xEA8F;" Content="{DynamicResource S_Page_Notify}" ToolTip="{DynamicResource S_Notify_Hub_Sub}" Command="{Binding OpenSettingsPageCommand}" CommandParameter="notify"/>
                <Button Style="{StaticResource HubCard}" Tag="&#xE7C3;" Content="{DynamicResource S_SettingsView_015}" ToolTip="{DynamicResource S_SettingsView_016}" Command="{Binding OpenSettingsPageCommand}" CommandParameter="logs"/>
                <!-- Политики конфиденциальности здесь нет: она открывается из «О приложении»,
                     где ей и место, и в хабе не занимает строку. -->
                <Button Style="{StaticResource HubCard}" Tag="&#xE946;" Content="{DynamicResource S_SettingsView_017}" ToolTip="{DynamicResource S_SettingsView_018}" Command="{Binding OpenSettingsPageCommand}" CommandParameter="about"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= ОФОРМЛЕНИЕ ================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="PageScroll_PreviewMouseWheel"
                      Visibility="{Binding SettingsPage, Converter={StaticResource EnumVis}, ConverterParameter=appearance}">
            <StackPanel Margin="24,20,24,24">

                <!-- Шрифт — единственное, что осталось настраиваемым. Темы, цвета, прозрачность,
                     картинки луны и фон убраны: слишком много ручек ради того, что почти никто
                     не трогает, а поддерживать их надо было в обеих версиях. -->
                <TextBlock Text="{DynamicResource S_SettingsView_019}" Foreground="{StaticResource SectionLabel}" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,0,8"/>
                <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="14">
                    <ItemsControl ItemsSource="{Binding Fonts}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,8"
                                        Command="{Binding DataContext.SetFontCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>


        <!-- ================= ПОДКЛЮЧЕНИЕ ================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="PageScroll_PreviewMouseWheel"
                      Visibility="{Binding SettingsPage, Converter={StaticResource EnumVis}, ConverterParameter=connection}">
            <StackPanel Margin="24,20,24,24">

                <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="6">
                    <StackPanel>
                        <Grid Margin="12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="Kill Switch" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource S_SettingsView_022}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding KillSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Button Command="{Binding ResetKillSwitchCommand}" Cursor="Hand" HorizontalContentAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" Padding="12">
                                        <Grid>
                                            <!-- room for the glyph on the right, or the description's
                                                 second line runs straight under it -->
                                            <StackPanel Margin="0,0,30,0">
                                                <TextBlock Text="{DynamicResource S_SettingsView_023}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentText}"/>
                                                <TextBlock Text="{DynamicResource S_SettingsView_024}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#12FFFFFF"/></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <Grid Margin="12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="{DynamicResource S_SettingsView_025}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource S_SettingsView_026}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AllowLan}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="12,0,12,12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="{DynamicResource S_SettingsView_027}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource S_SettingsView_028}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LanThroughProxy}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <Grid Margin="12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="{DynamicResource S_SettingsView_029}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource S_SettingsView_030}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowProxyOnlyButton}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <StackPanel Margin="12">
                            <TextBlock Text="{DynamicResource S_SettingsView_031}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{DynamicResource S_SettingsView_032}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ProxyBypassHosts, UpdateSourceTrigger=LostFocus}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <StackPanel Margin="12">
                            <TextBlock Text="{DynamicResource S_SettingsView_033}" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LocalProxyInfo}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource S_SettingsView_034}" Foreground="{StaticResource SectionLabel}" FontSize="10.5" FontWeight="SemiBold" Margin="4,18,0,8"/>
                <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="6">
                    <StackPanel>
                        <Grid Margin="12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="{DynamicResource S_SettingsView_035}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource S_SettingsView_036}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Socks5Auth}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Visibility="{Binding Socks5Auth, Converter={StaticResource BoolVis}}">
                            <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                            <Grid Margin="12">
                                <TextBlock Text="{DynamicResource S_SettingsView_037}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProxyUser}" FontFamily="Consolas" Foreground="{StaticResource AccentText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource GlyphButton}" Content="&#xE8C8;" Command="{Binding CopyProxyUserCommand}" ToolTip="{DynamicResource S_SettingsView_038}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="12,0,12,12">
                                <TextBlock Text="{DynamicResource S_SettingsView_039}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProxyPassMasked}" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource GlyphButton}" Content="&#xE8C8;" Command="{Binding CopyProxyPassCommand}" ToolTip="{DynamicResource S_SettingsView_040}"/>
                                </StackPanel>
                            </Grid>
                            <Button Command="{Binding ResetProxyCredsCommand}" Cursor="Hand" HorizontalContentAlignment="Left" Margin="6,0,0,10">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="Transparent" Padding="6,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource AccentText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{DynamicResource S_SettingsView_041}" Foreground="{StaticResource AccentText}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <Grid Margin="12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="{DynamicResource S_SettingsView_042}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource S_SettingsView_043}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BlockUdp}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <Grid Margin="12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="{DynamicResource S_SettingsView_044}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource S_SettingsView_045}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HttpProxyAuth}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Приоритет трафика — бета, по умолчанию выключен -->
                <TextBlock Text="{DynamicResource S_SettingsView_046}" Foreground="{StaticResource SectionLabel}" FontSize="10.5" FontWeight="SemiBold" Margin="4,18,0,8"/>
                <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource S_SettingsView_047}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border CornerRadius="6" Background="#33F5C042" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource S_SettingsView_048}" Foreground="#F5C042" FontSize="9.5" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="{DynamicResource S_SettingsView_049}"/>
                        <WrapPanel Margin="0,10,0,0">
                            <RadioButton Style="{StaticResource Chip}" GroupName="prio" Content="{DynamicResource S_SettingsView_050}" Margin="0,0,8,8"
                                         Command="{Binding SetTrafficPriorityCommand}" CommandParameter="off" IsChecked="{Binding IsPriorityOff, Mode=OneWay}"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="prio" Content="{DynamicResource S_SettingsView_051}" Margin="0,0,8,8"
                                         Command="{Binding SetTrafficPriorityCommand}" CommandParameter="balance" IsChecked="{Binding IsPriorityBalance, Mode=OneWay}"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="prio" Content="{DynamicResource S_SettingsView_052}" Margin="0,0,0,8"
                                         Command="{Binding SetTrafficPriorityCommand}" CommandParameter="games" IsChecked="{Binding IsPriorityGames, Mode=OneWay}"/>
                        </WrapPanel>
                        <!-- The two readouts get a row to themselves; sharing it with the button
                             squeezed them until the labels ran into each other. -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{DynamicResource S_SettingsView_053}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding LearnedCapacity}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{DynamicResource S_SettingsView_054}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding LearnedBaseline}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource S_SettingsView_055}" HorizontalAlignment="Left"
                                Command="{Binding ResetLearnedCapacityCommand}" Padding="14,7" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= МАРШРУТИЗАЦИЯ ================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="PageScroll_PreviewMouseWheel"
                      Visibility="{Binding SettingsPage, Converter={StaticResource EnumVis}, ConverterParameter=routing}">
            <StackPanel Margin="24,20,24,24">

                <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="6">
                    <StackPanel>
                        <Grid Margin="12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="{DynamicResource S_SettingsView_056}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource S_SettingsView_057}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseRouting}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Routing" Cursor="Hand" HorizontalContentAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" Padding="12">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource S_SettingsView_058}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding RoutingSubtitle}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#12FFFFFF"/></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <Grid Margin="12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="{DynamicResource S_SettingsView_059}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource S_SettingsView_060}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding TlsFragment}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="12,0,12,12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="{DynamicResource S_SettingsView_061}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource S_SettingsView_062}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Mux}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="12,0,12,12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="{DynamicResource S_SettingsView_063}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource S_SettingsView_064}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Sniffing}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>

                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <Button Command="{Binding OpenSettingsPageCommand}" CommandParameter="approuting" Cursor="Hand" HorizontalContentAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" Padding="12">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource S_SettingsView_065}" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{DynamicResource S_SettingsView_066}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#12FFFFFF"/></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <StackPanel Margin="12">
                            <Grid>
                                <TextBlock Text="{DynamicResource S_SettingsView_067}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding PreferredIpLabel}" Foreground="{StaticResource AccentText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
