<UserControl x:Class="MoonInternet.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <UserControl.Resources>
        <!-- hub category card: icon + title + chevron -->
        <Style x:Key="HubCard" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="15,14">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="11" Background="#2C2058" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="14.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{TemplateBinding ToolTip}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- link row inside a card: label + chevron, navigates via Command/CommandParameter -->
        <Style x:Key="NavRow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" Padding="14,12">
                            <Grid>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="13.5" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#12FFFFFF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- "coming soon" placeholder row -->
        <Style x:Key="SoonRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- pinned header -->
            <RowDefinition Height="*"/>       <!-- the pages -->
        </Grid.RowDefinitions>

        <!-- One header for every sub-page, outside the scrolling area so it stays put. It used to
             live inside each page's ScrollViewer and scrolled away with the content, which left
             no way back without scrolling to the top first. The hub keeps its own big title. -->
        <Border Grid.Row="0" Background="{StaticResource WinBg}" Padding="24,18,24,12"
                Visibility="{Binding IsSettingsSubPage, Converter={StaticResource BoolVis}}"
                shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GlyphButton}" Content="&#xE72B;" Command="{Binding SettingsBackCommand}" ToolTip="Назад"/>
                <TextBlock Text="{Binding SettingsPageTitle}" FontSize="22" FontWeight="Bold" Margin="6,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
        <!-- ================= HUB ================= -->
        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding SettingsPage, Converter={StaticResource EnumVis}, ConverterParameter=hub}">
            <StackPanel Margin="24,20,24,24">
                <TextBlock Text="Настройки" FontSize="26" FontWeight="Bold" Margin="2,4,0,2"/>
                <TextBlock Text="Moon Internet · 0.9.0 beta" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="2,0,0,18"/>

                <Button Style="{StaticResource HubCard}" Tag="&#xE790;" Content="Оформление" ToolTip="Шрифт" Command="{Binding OpenSettingsPageCommand}" CommandParameter="appearance"/>
                <Button Style="{StaticResource HubCard}" Tag="&#xE839;" Content="Подключение" ToolTip="TUN, авто-переподключение, kill-switch" Command="{Binding OpenSettingsPageCommand}" CommandParameter="connection"/>
                <Button Style="{StaticResource HubCard}" Tag="&#xE71B;" Content="Маршрутизация" ToolTip="Профили, правила, приложения, DNS" Command="{Binding OpenSettingsPageCommand}" CommandParameter="routing"/>
                <Button Style="{StaticResource HubCard}" Tag="&#xE8F1;" Content="Настройки подписок" ToolTip="Обновление, срок, авто-обновление" Command="{Binding OpenSettingsPageCommand}" CommandParameter="subs"/>
                <Button Style="{StaticResource HubCard}" Tag="&#xEC4A;" Content="Настройки пинга" ToolTip="Как и когда измерять задержку" Command="{Binding OpenSettingsPageCommand}" CommandParameter="ping"/>
                <Button Style="{StaticResource HubCard}" Tag="&#xEC92;" Content="Авто" ToolTip="Автозапуск, автоподключение, трей" Command="{Binding OpenSettingsPageCommand}" CommandParameter="auto"/>
                <Button Style="{StaticResource HubCard}" Tag="&#xE7C3;" Content="Логи" ToolTip="Диагностика и журналы" Command="{Binding OpenSettingsPageCommand}" CommandParameter="logs"/>
                <!-- Политики конфиденциальности здесь нет: она открывается из «О приложении»,
                     где ей и место, и в хабе не занимает строку. -->
                <Button Style="{StaticResource HubCard}" Tag="&#xE946;" Content="О приложении" ToolTip="Версии, ссылки, система" Command="{Binding OpenSettingsPageCommand}" CommandParameter="about"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= ОФОРМЛЕНИЕ ================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="PageScroll_PreviewMouseWheel"
                      Visibility="{Binding SettingsPage, Converter={StaticResource EnumVis}, ConverterParameter=appearance}">
            <StackPanel Margin="24,20,24,24">

                <!-- Шрифт — единственное, что осталось настраиваемым. Темы, цвета, прозрачность,
                     картинки луны и фон убраны: слишком много ручек ради того, что почти никто
                     не трогает, а поддерживать их надо было в обеих версиях. -->
                <TextBlock Text="ШРИФТ" Foreground="{StaticResource SectionLabel}" FontSize="10.5" FontWeight="SemiBold" Margin="4,0,0,8"/>
                <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="14">
                    <ItemsControl ItemsSource="{Binding Fonts}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,8"
                                        Command="{Binding DataContext.SetFontCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding}" FontFamily="{Binding}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>


        <!-- ================= ПОДКЛЮЧЕНИЕ ================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="PageScroll_PreviewMouseWheel"
                      Visibility="{Binding SettingsPage, Converter={StaticResource EnumVis}, ConverterParameter=connection}">
            <StackPanel Margin="24,20,24,24">

                <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="6">
                    <StackPanel>
                        <Grid Margin="12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="Авто-переподключение" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Если ядро упало — переподключиться автоматически" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AutoReconnect}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <Grid Margin="12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="Kill Switch" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Блокировать трафик при отключении VPN" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding KillSwitch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Button Command="{Binding ResetKillSwitchCommand}" Cursor="Hand" HorizontalContentAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" Padding="12">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="Сбросить Kill Switch" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentText}"/>
                                                <TextBlock Text="Удалить правила фаервола, если интернет заблокирован после краша" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#12FFFFFF"/></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <Grid Margin="12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="Разрешить LAN подключения" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Исключить локальную сеть из VPN туннеля" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding AllowLan}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="12,0,12,12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="LAN через прокси" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Направить локальный трафик через VPN прокси" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding LanThroughProxy}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <Grid Margin="12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="Кнопка &quot;Только прокси&quot;" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Показывать кнопку на главном экране" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ShowProxyOnlyButton}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <StackPanel Margin="12">
                            <TextBlock Text="Дополнительные адреса в обход прокси" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Хосты в обход системного прокси (напр. *.local)" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding ProxyBypassHosts, UpdateSourceTrigger=LostFocus}" Margin="0,8,0,0"/>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <StackPanel Margin="12">
                            <TextBlock Text="Локальный прокси" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding LocalProxyInfo}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="SOCKS5 / ПРОКСИ" Foreground="{StaticResource SectionLabel}" FontSize="10.5" FontWeight="SemiBold" Margin="4,18,0,8"/>
                <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="6">
                    <StackPanel>
                        <Grid Margin="12">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="SOCKS5 авторизация" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Защищает локальный прокси от приложений, которые сканируют порты для обнаружения VPN" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Socks5Auth}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Visibility="{Binding Socks5Auth, Converter={StaticResource BoolVis}}">
                            <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                            <Grid Margin="12">
                                <TextBlock Text="Логин" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProxyUser}" FontFamily="Consolas" Foreground="{StaticResource AccentText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource GlyphButton}" Content="&#xE8C8;" Command="{Binding CopyProxyUserCommand}" ToolTip="Скопировать логин"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="12,0,12,12">
                                <TextBlock Text="Пароль" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProxyPassMasked}" FontFamily="Consolas" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Style="{StaticResource GlyphButton}" Content="&#xE8C8;" Command="{Binding CopyProxyPassCommand}" ToolTip="Скопировать пароль"/>
                                </StackPanel>
                            </Grid>
                            <Button Command="{Binding ResetProxyCredsCommand}" Cursor="Hand" HorizontalContentAlignment="Left" Margin="6,0,0,10">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="b" Background="Transparent" Padding="6,4">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{StaticResource AccentText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="Сбросить логин/пароль" Foreground="{StaticResource AccentText}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <Grid Margin="12">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Блокировать UDP" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Сломает DNS-over-UDP, QUIC, голосовые звонки, игры. Включайте только если знаете зачем" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding BlockUdp}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <Grid Margin="12">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="HTTP-прокси авторизация" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Защитить HTTP-прокси теми же логином/паролем" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding HttpProxyAuth}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Приоритет трафика — бета, по умолчанию выключен -->
                <TextBlock Text="ПРИОРИТЕТ ТРАФИКА" Foreground="{StaticResource SectionLabel}" FontSize="10.5" FontWeight="SemiBold" Margin="4,18,0,8"/>
                <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Приоритет трафика" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border CornerRadius="6" Background="#33F5C042" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="БЕТА" Foreground="#F5C042" FontSize="9.5" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Не даёт закачке забить очередь, из-за которой в играх и звонках подскакивает пинг. Укорачивает буфер и отключает мультиплексирование. Скорость закачки может немного снизиться."/>
                        <WrapPanel Margin="0,10,0,0">
                            <RadioButton Style="{StaticResource Chip}" GroupName="prio" Content="Выключен" Margin="0,0,8,8"
                                         Command="{Binding SetTrafficPriorityCommand}" CommandParameter="off" IsChecked="{Binding IsPriorityOff, Mode=OneWay}"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="prio" Content="Баланс" Margin="0,0,8,8"
                                         Command="{Binding SetTrafficPriorityCommand}" CommandParameter="balance" IsChecked="{Binding IsPriorityBalance, Mode=OneWay}"/>
                            <RadioButton Style="{StaticResource Chip}" GroupName="prio" Content="Игры и звонки" Margin="0,0,0,8"
                                         Command="{Binding SetTrafficPriorityCommand}" CommandParameter="games" IsChecked="{Binding IsPriorityGames, Mode=OneWay}"/>
                        </WrapPanel>
                        <!-- The two readouts get a row to themselves; sharing it with the button
                             squeezed them until the labels ran into each other. -->
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Замерена скорость" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding LearnedCapacity}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Пинг без нагрузки" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding LearnedBaseline}" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Button Style="{StaticResource SecondaryButton}" Content="Сбросить замеры" HorizontalAlignment="Left"
                                Command="{Binding ResetLearnedCapacityCommand}" Padding="14,7" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ================= МАРШРУТИЗАЦИЯ ================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" PreviewMouseWheel="PageScroll_PreviewMouseWheel"
                      Visibility="{Binding SettingsPage, Converter={StaticResource EnumVis}, ConverterParameter=routing}">
            <StackPanel Margin="24,20,24,24">

                <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="6">
                    <StackPanel>
                        <Grid Margin="12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="Профили маршрутизации" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Раздельное туннелирование с профилями" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UseRouting}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Routing" Cursor="Hand" HorizontalContentAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" Padding="12">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="Настройки маршрутизации" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding RoutingName, StringFormat='Профиль, правила · {0}'}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#12FFFFFF"/></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <Grid Margin="12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="Фрагментация" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Разделение TLS hello для обхода блокировок" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding TlsFragment}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="12,0,12,12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="Мультиплексирование" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Мультиплексирование соединений" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Mux}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="12,0,12,12">
                            <StackPanel Margin="0,0,58,0">
                                <TextBlock Text="Снифинг" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="Определение протокола для маршрутизации" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Sniffing}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>

                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="12,0"/>
                        <Button Command="{Binding OpenSettingsPageCommand}" CommandParameter="approuting" Cursor="Hand" HorizontalContentAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" Background="Transparent" Padding="12">
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="Прокси по приложениям" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="Раздельное туннелирование по приложениям" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#12FFFFFF"/></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
