<UserControl x:Class="MoonInternet.App.Views.RoutingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
    <UserControl.Resources>
        <!-- one rule chip; the × (remove) shows only when the custom profile is active -->
        <DataTemplate x:Key="RuleChip">
            <Border Background="#1EFFFFFF" CornerRadius="7" Padding="8,3" Margin="0,0,6,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Value}" Foreground="{StaticResource TextPrimary}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="9" Width="16" Height="16" Padding="0" Margin="6,0,0,0" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}" Cursor="Hand"
                            Visibility="{Binding DataContext.CanEditRouting, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}"
                            Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="Wrap"><WrapPanel/></ItemsPanelTemplate>

        <!-- One routing profile. A RadioButton rather than a Button so "this is the active one"
             is the control's own state: IsChecked compares the item with SelectedRouting, the
             same Eq multi-binding the protocol chips use. -->
        <!-- RoutingRow() from RoutingScreen.kt, line for line: a 34px glyph tile that takes the
             accent when the row is picked, the name with an optional source badge, the line saying
             what the profile does, and the trailing chevron or menu. Selection is the accent
             outline we use for the active server, not a radio column. -->
        <!-- RadioRow() from RoutingEditor.kt: a filled accent circle with a tick, a title and
             the line under it. WPF's stock radio is a grey dot and looks nothing like it. -->
        <Style x:Key="MoonRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="row" Background="Transparent" Padding="0,4">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,2,12,0">
                                    <Ellipse x:Name="ring" Stroke="{StaticResource BorderSoft}" StrokeThickness="1.5"/>
                                    <Ellipse x:Name="dot" Fill="{StaticResource Accent}" Visibility="Collapsed"/>
                                    <TextBlock x:Name="tick" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Grid>
                                <StackPanel>
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="13"/>
                                    <TextBlock Text="{TemplateBinding Tag}" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="Transparent"/>
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- SheetItem() from Sheets.kt: a glyph, a label, the whole row is the button. -->
        <Style x:Key="SheetItem" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="r" Background="Transparent" Padding="20,11">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Width="26"/>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="14"
                                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="r" Property="Background" Value="#14FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RoutingCard">
            <Button Cursor="Hand" Margin="0,0,0,10" HorizontalContentAlignment="Stretch"
                    Command="{Binding DataContext.ActivateRoutingRowCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="card" CornerRadius="14" Padding="14,12" Background="{StaticResource Card}"
                                BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="tile" Grid.Column="0" Width="34" Height="34" CornerRadius="10"
                                        Background="{StaticResource ChipBg}" VerticalAlignment="Center">
                                    <TextBlock x:Name="glyph" Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                               Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <Border CornerRadius="6" Background="#26B9A8FF" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Visibility="{Binding HasBadge, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding Badge}" Foreground="{StaticResource AccentText}" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextSecondary}" FontSize="11.5"
                                               Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                           Visibility="{Binding HasChevron, Converter={StaticResource BoolVis}}"/>
                                <Button Grid.Column="2" Style="{StaticResource GlyphButton}" Content="&#xE712;" FontSize="15"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding HasMenu, Converter={StaticResource BoolVis}}"
                                        Command="{Binding DataContext.OpenRoutingSheetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding Profile}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="card" Property="Background" Value="#18FFFFFF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Selected}" Value="True">
                                <Setter TargetName="card" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter TargetName="card" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="tile" Property="Background" Value="#29B9A8FF"/>
                                <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="24,20,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <!-- One header for all three levels, like the phone: the back arrow goes up a
                     level rather than always out to settings, and the title says where you are. -->
                <Grid Margin="0,4,0,6" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal" Margin="0,0,110,0">
                        <Button Style="{StaticResource GlyphButton}" Content="&#xE72B;" Command="{Binding RoutingBackCommand}"/>
                        <TextBlock Text="{Binding RoutingHeader}" FontSize="21" FontWeight="Bold" Margin="6,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource GlyphButton}"
                            Content="&#xE710;" FontSize="18" Foreground="{StaticResource Accent}"
                            Visibility="{Binding ShowRoutingAdd, Converter={StaticResource BoolVis}}"
                            Command="{Binding NewRoutingCommand}"/>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}"
                            Padding="16,7" FontSize="13" Content="{DynamicResource S_Routing_Save}"
                            Visibility="{Binding IsEditingRouting, Converter={StaticResource BoolVis}}"
                            Command="{Binding CloseRoutingEditorCommand}"/>
                </Grid>

                <TextBlock Text="{DynamicResource S_Routing_Subtitle}" Foreground="{StaticResource TextSecondary}"
                           FontSize="12.5" Margin="4,0,0,10" TextWrapping="Wrap"
                           Visibility="{Binding ShowRoutingAdd, Converter={StaticResource BoolVis}}"/>
                <TextBlock Text="{DynamicResource S_Routing_SubHint}" Foreground="{StaticResource TextSecondary}"
                           FontSize="12.5" Margin="4,0,0,10" TextWrapping="Wrap"
                           Visibility="{Binding InRoutingSub, Converter={StaticResource BoolVis}}"/>

            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Profiles: what we ship, then each subscription's own, then yours. A
                         subscription's routing sits under the subscription because that is where
                         it arrives from — and that is where INCY and HAPP sit side by side. -->
                    <!-- The two list levels; both step aside while the editor is open. -->
                    <StackPanel Visibility="{Binding NotEditingRouting, Converter={StaticResource BoolVis}}">
                    <!-- Top level, the same three blocks the phone shows: the shipped pair, a row
                         per subscription you step into, then your own copies. -->
                    <StackPanel Visibility="{Binding NotInRoutingSub, Converter={StaticResource BoolVis}}">
                        <ItemsControl ItemsSource="{Binding RoutingAutoRow}" ItemTemplate="{StaticResource RoutingCard}"/>

                        <!-- Which of a subscription's pair Авто reaches for. Only while the mode is
                             on: with a profile pinned by hand there is nothing for it to decide. -->
                        <!-- Folds open and shut rather than blinking: it sits between two cards,
                             and appearing between frames reads as the list jumping. -->
                        <Border x:Name="prefCard" CornerRadius="12" Background="{StaticResource Card}"
                                BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                                Padding="14,10" Margin="0,0,0,10" ClipToBounds="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="MaxHeight" Value="0"/>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRoutingAuto}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="140" Duration="0:0:0.24">
                                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                                                        <DoubleAnimation Storyboard.TargetProperty="MaxHeight" To="0" Duration="0:0:0.16"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource S_Routing_Prefer}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource S_Routing_PreferHint}" Foreground="{StaticResource TextMuted}"
                                           FontSize="11" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="autopref" Content="INCY" Margin="0,0,8,0"
                                                 IsChecked="{Binding AutoPrefersIncy, Mode=OneWay}"
                                                 Command="{Binding SetAutoPreferenceCommand}" CommandParameter="incy"/>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="autopref" Content="HAPP"
                                                 IsChecked="{Binding AutoPrefersHapp, Mode=OneWay}"
                                                 Command="{Binding SetAutoPreferenceCommand}" CommandParameter="happ"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <ItemsControl ItemsSource="{Binding RoutingBuiltinRows}" ItemTemplate="{StaticResource RoutingCard}"/>

                        <TextBlock Text="{DynamicResource S_Routing_SecSubs}" Foreground="{StaticResource TextMuted}"
                                   FontSize="10.5" FontWeight="SemiBold" Margin="4,8,0,6"
                                   Visibility="{Binding HasRoutingSubs, Converter={StaticResource BoolVis}}"/>
                        <ItemsControl ItemsSource="{Binding RoutingSubscriptionRows}" ItemTemplate="{StaticResource RoutingCard}"/>

                        <TextBlock Text="{DynamicResource S_Routing_SecMine}" Foreground="{StaticResource TextMuted}"
                                   FontSize="10.5" FontWeight="SemiBold" Margin="4,8,0,6"
                                   Visibility="{Binding HasRoutingMine, Converter={StaticResource BoolVis}}"/>
                        <ItemsControl ItemsSource="{Binding RoutingMineRows}" ItemTemplate="{StaticResource RoutingCard}"/>
                    </StackPanel>

                    <!-- Inside one subscription: INCY and HAPP side by side, which is the choice the
                         old segmented control used to make. -->
                    <StackPanel Visibility="{Binding InRoutingSub, Converter={StaticResource BoolVis}}">
                        <ItemsControl ItemsSource="{Binding RoutingSubRows}" ItemTemplate="{StaticResource RoutingCard}"/>
                    </StackPanel>

                    </StackPanel>

                    <!-- ===== profile editor: its own screen, like RoutingEditorScreen.kt ===== -->
                    <StackPanel Visibility="{Binding IsEditingRouting, Converter={StaticResource BoolVis}}">

                        <TextBlock Text="{DynamicResource S_Routing_SecBasic}" Foreground="{StaticResource TextMuted}"
                                   FontSize="10.5" FontWeight="SemiBold" Margin="4,0,0,6"/>
                        <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}"
                                BorderThickness="1" Margin="0,0,0,10">
                            <StackPanel Margin="14,12">
                                <TextBlock Text="{DynamicResource S_Routing_NameLabel}" Foreground="{StaticResource TextSecondary}" FontSize="11.5"/>
                                <TextBox Style="{StaticResource DarkTextBox}" Margin="0,6,0,0"
                                         Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                                <Border Height="1" Background="{StaticResource BorderSoft}" Margin="0,12,0,12"/>
                                <Grid>
                                    <StackPanel Margin="0,0,58,0">
                                        <TextBlock Text="{DynamicResource S_Routing_Global}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="{DynamicResource S_Routing_GlobalHint}" Foreground="{StaticResource TextSecondary}"
                                                   FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding EditGlobalProxy}"
                                              HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource S_Routing_SecDns}" Foreground="{StaticResource TextMuted}"
                                   FontSize="10.5" FontWeight="SemiBold" Margin="4,0,0,6"/>
                        <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}"
                                BorderThickness="1" Margin="0,0,0,10">
                            <StackPanel Margin="14,12">
                                <TextBlock Text="{DynamicResource S_Routing_DnsRemote}" Foreground="{StaticResource AccentText}"
                                           FontSize="12" FontWeight="SemiBold"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="rdns" Content="DoH" Margin="0,0,6,6" Command="{Binding SetEditDnsTypeCommand}" CommandParameter="remote:DoH">
                                                 <RadioButton.IsChecked>
                                                     <MultiBinding Converter="{StaticResource Eq}" Mode="OneWay">
                                                         <Binding Path="EditRemoteDnsType"/>
                                                         <Binding Source="DoH"/>
                                                     </MultiBinding>
                                                 </RadioButton.IsChecked>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="rdns" Content="DoT" Margin="0,0,6,6" Command="{Binding SetEditDnsTypeCommand}" CommandParameter="remote:DoT">
                                                 <RadioButton.IsChecked>
                                                     <MultiBinding Converter="{StaticResource Eq}" Mode="OneWay">
                                                         <Binding Path="EditRemoteDnsType"/>
                                                         <Binding Source="DoT"/>
                                                     </MultiBinding>
                                                 </RadioButton.IsChecked>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="rdns" Content="DoU" Margin="0,0,6,6" Command="{Binding SetEditDnsTypeCommand}" CommandParameter="remote:DoU">
                                                 <RadioButton.IsChecked>
                                                     <MultiBinding Converter="{StaticResource Eq}" Mode="OneWay">
                                                         <Binding Path="EditRemoteDnsType"/>
                                                         <Binding Source="DoU"/>
                                                     </MultiBinding>
                                                 </RadioButton.IsChecked>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="rdns" Content="TCP" Margin="0,0,0,6" Command="{Binding SetEditDnsTypeCommand}" CommandParameter="remote:TCP">
                                                 <RadioButton.IsChecked>
                                                     <MultiBinding Converter="{StaticResource Eq}" Mode="OneWay">
                                                         <Binding Path="EditRemoteDnsType"/>
                                                         <Binding Source="TCP"/>
                                                     </MultiBinding>
                                                 </RadioButton.IsChecked>
                                    </RadioButton>
                                </WrapPanel>
                                <TextBox Style="{StaticResource DarkTextBox}" Margin="0,4,0,0"
                                         Text="{Binding EditRemoteDns, UpdateSourceTrigger=PropertyChanged}"/>

                                <Border Height="1" Background="{StaticResource BorderSoft}" Margin="0,14,0,12"/>

                                <TextBlock Text="{DynamicResource S_Routing_DnsDomestic}" Foreground="#4ED8A0"
                                           FontSize="12" FontWeight="SemiBold"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <RadioButton Style="{StaticResource Chip}" GroupName="ddns" Content="DoH" Margin="0,0,6,6" Command="{Binding SetEditDnsTypeCommand}" CommandParameter="domestic:DoH">
                                                 <RadioButton.IsChecked>
                                                     <MultiBinding Converter="{StaticResource Eq}" Mode="OneWay">
                                                         <Binding Path="EditDomesticDnsType"/>
                                                         <Binding Source="DoH"/>
                                                     </MultiBinding>
                                                 </RadioButton.IsChecked>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="ddns" Content="DoT" Margin="0,0,6,6" Command="{Binding SetEditDnsTypeCommand}" CommandParameter="domestic:DoT">
                                                 <RadioButton.IsChecked>
                                                     <MultiBinding Converter="{StaticResource Eq}" Mode="OneWay">
                                                         <Binding Path="EditDomesticDnsType"/>
                                                         <Binding Source="DoT"/>
                                                     </MultiBinding>
                                                 </RadioButton.IsChecked>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="ddns" Content="DoU" Margin="0,0,6,6" Command="{Binding SetEditDnsTypeCommand}" CommandParameter="domestic:DoU">
                                                 <RadioButton.IsChecked>
                                                     <MultiBinding Converter="{StaticResource Eq}" Mode="OneWay">
                                                         <Binding Path="EditDomesticDnsType"/>
                                                         <Binding Source="DoU"/>
                                                     </MultiBinding>
                                                 </RadioButton.IsChecked>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Chip}" GroupName="ddns" Content="TCP" Margin="0,0,0,6" Command="{Binding SetEditDnsTypeCommand}" CommandParameter="domestic:TCP">
                                                 <RadioButton.IsChecked>
                                                     <MultiBinding Converter="{StaticResource Eq}" Mode="OneWay">
                                                         <Binding Path="EditDomesticDnsType"/>
                                                         <Binding Source="TCP"/>
                                                     </MultiBinding>
                                                 </RadioButton.IsChecked>
                                    </RadioButton>
                                </WrapPanel>
                                <TextBox Style="{StaticResource DarkTextBox}" Margin="0,4,0,0"
                                         Text="{Binding EditDomesticDns, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource S_Routing_SecRules}" Foreground="{StaticResource TextMuted}"
                                   FontSize="10.5" FontWeight="SemiBold" Margin="4,0,0,6"/>

                    <!-- DIRECT — Bucket() from RoutingEditor.kt: the counts as two chips, the hint
                         under the name, and inside the open bucket the chips, a line to type a rule
                         into with its Добавить, and the geo-category button across the width. -->
                    <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GlyphButton}" Width="24" Height="24" FontSize="11" Content="&#xE70D;" Command="{Binding ToggleBucketCommand}" CommandParameter="direct"/>
                                    <TextBlock Text="DIRECT" Foreground="{StaticResource Green}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border CornerRadius="8" Background="#2534D399" Padding="7,1">
                                        <TextBlock Text="{Binding DirectCount}" Foreground="{StaticResource Green}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border CornerRadius="8" Background="#1EFFFFFF" Padding="7,1" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding DirectIpCount}" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{DynamicResource S_RoutingView_009}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="28,2,0,0"/>

                            <StackPanel Visibility="{Binding DirectOpen, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{DynamicResource S_Routing_Empty}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,10,0,0"
                                           Visibility="{Binding DirectEmpty, Converter={StaticResource BoolVis}}"/>
                                <ItemsControl ItemsSource="{Binding DirectRules}" ItemTemplate="{StaticResource RuleChip}" ItemsPanel="{StaticResource Wrap}" Margin="0,10,0,0"/>
                                <Grid Margin="0,10,0,0" Visibility="{Binding CanEditRouting, Converter={StaticResource BoolVis}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource DarkTextBox}" Text="{Binding DirectInput, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="14,7" Margin="8,0,0,0" FontSize="12.5"
                                            Content="{DynamicResource S_RoutingView_008}" Command="{Binding AddDirectCommand}"/>
                                </Grid>
                                <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Cursor="Hand"
                                        Visibility="{Binding CanEditRouting, Converter={StaticResource BoolVis}}"
                                        Command="{Binding PickGeoForCommand}" CommandParameter="direct">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="g" CornerRadius="10" Background="#22B9A8FF" BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="0,9">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentText}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource S_RoutingView_015}" Foreground="{StaticResource AccentText}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="g" Property="Background" Value="#33B9A8FF"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- PROXY — Bucket() from RoutingEditor.kt: the counts as two chips, the hint
                         under the name, and inside the open bucket the chips, a line to type a rule
                         into with its Добавить, and the geo-category button across the width. -->
                    <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GlyphButton}" Width="24" Height="24" FontSize="11" Content="&#xE70D;" Command="{Binding ToggleBucketCommand}" CommandParameter="proxy"/>
                                    <TextBlock Text="PROXY" Foreground="{StaticResource AccentText}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border CornerRadius="8" Background="#26B9A8FF" Padding="7,1">
                                        <TextBlock Text="{Binding ProxyCount}" Foreground="{StaticResource AccentText}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border CornerRadius="8" Background="#1EFFFFFF" Padding="7,1" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding ProxyIpCount}" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{DynamicResource S_RoutingView_011}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="28,2,0,0"/>

                            <StackPanel Visibility="{Binding ProxyOpen, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{DynamicResource S_Routing_Empty}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,10,0,0"
                                           Visibility="{Binding ProxyEmpty, Converter={StaticResource BoolVis}}"/>
                                <ItemsControl ItemsSource="{Binding ProxyRules}" ItemTemplate="{StaticResource RuleChip}" ItemsPanel="{StaticResource Wrap}" Margin="0,10,0,0"/>
                                <Grid Margin="0,10,0,0" Visibility="{Binding CanEditRouting, Converter={StaticResource BoolVis}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource DarkTextBox}" Text="{Binding ProxyInput, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="14,7" Margin="8,0,0,0" FontSize="12.5"
                                            Content="{DynamicResource S_RoutingView_008}" Command="{Binding AddProxyCommand}"/>
                                </Grid>
                                <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Cursor="Hand"
                                        Visibility="{Binding CanEditRouting, Converter={StaticResource BoolVis}}"
                                        Command="{Binding PickGeoForCommand}" CommandParameter="proxy">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="g" CornerRadius="10" Background="#22B9A8FF" BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="0,9">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentText}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource S_RoutingView_015}" Foreground="{StaticResource AccentText}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="g" Property="Background" Value="#33B9A8FF"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- BLOCK — Bucket() from RoutingEditor.kt: the counts as two chips, the hint
                         under the name, and inside the open bucket the chips, a line to type a rule
                         into with its Добавить, and the geo-category button across the width. -->
                    <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="14,12" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GlyphButton}" Width="24" Height="24" FontSize="11" Content="&#xE70D;" Command="{Binding ToggleBucketCommand}" CommandParameter="block"/>
                                    <TextBlock Text="BLOCK" Foreground="{StaticResource Danger}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border CornerRadius="8" Background="#26FF6B8A" Padding="7,1">
                                        <TextBlock Text="{Binding BlockCount}" Foreground="{StaticResource Danger}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border CornerRadius="8" Background="#1EFFFFFF" Padding="7,1" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding BlockIpCount}" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{DynamicResource S_RoutingView_013}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="28,2,0,0"/>

                            <StackPanel Visibility="{Binding BlockOpen, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{DynamicResource S_Routing_Empty}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,10,0,0"
                                           Visibility="{Binding BlockEmpty, Converter={StaticResource BoolVis}}"/>
                                <ItemsControl ItemsSource="{Binding BlockRules}" ItemTemplate="{StaticResource RuleChip}" ItemsPanel="{StaticResource Wrap}" Margin="0,10,0,0"/>
                                <Grid Margin="0,10,0,0" Visibility="{Binding CanEditRouting, Converter={StaticResource BoolVis}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource DarkTextBox}" Text="{Binding BlockInput, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="14,7" Margin="8,0,0,0" FontSize="12.5"
                                            Content="{DynamicResource S_RoutingView_008}" Command="{Binding AddBlockCommand}"/>
                                </Grid>
                                <Button Margin="0,8,0,0" HorizontalAlignment="Stretch" Cursor="Hand"
                                        Visibility="{Binding CanEditRouting, Converter={StaticResource BoolVis}}"
                                        Command="{Binding PickGeoForCommand}" CommandParameter="block">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="g" CornerRadius="10" Background="#22B9A8FF" BorderBrush="{StaticResource Accent}" BorderThickness="1" Padding="0,9">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentText}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{DynamicResource S_RoutingView_015}" Foreground="{StaticResource AccentText}" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="g" Property="Background" Value="#33B9A8FF"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>


                        <TextBlock Text="{DynamicResource S_Routing_SecAdv}" Foreground="{StaticResource TextMuted}"
                                   FontSize="10.5" FontWeight="SemiBold" Margin="4,8,0,6"/>
                        <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}"
                                BorderThickness="1" Margin="0,0,0,10">
                            <StackPanel Margin="14,12">
                                <TextBlock Text="{DynamicResource S_Routing_DomainStrategy}" FontSize="13.5" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <RadioButton Style="{StaticResource MoonRadio}" GroupName="ds" Content="{DynamicResource S_Routing_DsAsIs}" Tag="{DynamicResource S_Routing_DsAsIsHint}"
                                             IsChecked="{Binding IsDsAsIs, Mode=OneWay}" Command="{Binding SetDomainStrategyCommand}" CommandParameter="AsIs"/>
                                <RadioButton Style="{StaticResource MoonRadio}" GroupName="ds" Content="{DynamicResource S_Routing_DsIfNo}" Tag="{DynamicResource S_Routing_DsIfNoHint}"
                                             IsChecked="{Binding IsDsIfNoMatch, Mode=OneWay}" Command="{Binding SetDomainStrategyCommand}" CommandParameter="IPIfNonMatch"/>
                                <RadioButton Style="{StaticResource MoonRadio}" GroupName="ds" Content="{DynamicResource S_Routing_DsOnDemand}" Tag="{DynamicResource S_Routing_DsOnDemandHint}"
                                             IsChecked="{Binding IsDsOnDemand, Mode=OneWay}" Command="{Binding SetDomainStrategyCommand}" CommandParameter="IPOnDemand"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{DynamicResource S_Routing_SecGeo}" Foreground="{StaticResource TextMuted}"
                                   FontSize="10.5" FontWeight="SemiBold" Margin="4,8,0,6"/>
                <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}"
                                BorderThickness="1" Margin="0,0,0,10">
                            <StackPanel Margin="14,12">
                                <TextBlock Text="GeoIP URL" Foreground="{StaticResource TextSecondary}" FontSize="11.5"/>
                                <TextBox Style="{StaticResource DarkTextBox}" Margin="0,6,0,0"
                                         Text="{Binding EditGeoip, UpdateSourceTrigger=PropertyChanged}"/>
                                <Border Height="1" Background="{StaticResource BorderSoft}" Margin="0,12,0,12"/>
                                <TextBlock Text="GeoSite URL" Foreground="{StaticResource TextSecondary}" FontSize="11.5"/>
                                <TextBox Style="{StaticResource DarkTextBox}" Margin="0,6,0,0"
                                         Text="{Binding EditGeosite, UpdateSourceTrigger=PropertyChanged}"/>
                                <Border Height="1" Background="{StaticResource BorderSoft}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="14" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="14,12" Margin="0,0,0,10"
>
                            <StackPanel>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource S_RoutingView_003}" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Style="{StaticResource GlyphButton}" Content="&#xE72C;" HorizontalAlignment="Right"
                                            Command="{Binding RefreshGeoCommand}" IsEnabled="{Binding GeoRefreshing, Converter={StaticResource InvBool}}"/>
                                </Grid>
                                <!-- one block per distinct geoip/geosite pair: INCY and HAPP share a plate
                                     while they point at the same release, and split when they do not -->
                                <ItemsControl ItemsSource="{Binding GeoSources}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Owner}" FontSize="10.5" FontWeight="SemiBold" Margin="0,10,0,0"
                                                           Foreground="{StaticResource AccentText}"
                                                           Visibility="{Binding ShowOwner, Converter={StaticResource BoolVis}}"/>
                                                <Grid Margin="0,10,0,0">
                                                    <TextBlock Text="geoip.dat" FontSize="12.5" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding GeoipText}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Border Height="1" Background="{StaticResource BorderSoft}" Margin="0,8"/>
                                                <Grid>
                                                    <TextBlock Text="geosite.dat" FontSize="12.5" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding GeositeText}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding GeoStatus}" Foreground="{StaticResource AccentText}" FontSize="11.5" Margin="0,8,0,0"
                                           Visibility="{Binding GeoRefreshing, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                        </Border>


                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== add-rule dialog ===== -->
        <Border Panel.ZIndex="50" Background="#B3060410" Visibility="{Binding ShowRuleDialog, Converter={StaticResource BoolVis}}">
            <Border Width="330" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="16"
                    Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="20">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding RuleBucketTitle}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource GlyphButton}" Content="&#xE8BB;" Command="{Binding CloseRuleDialogCommand}"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource S_RoutingView_014}" Foreground="{StaticResource TextSecondary}" FontSize="11.5" Margin="2,12,0,6"/>
                    <TextBox Style="{StaticResource DarkTextBox}" Text="{Binding RuleInput, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenGeoBrowserCommand}" Padding="12,8" Margin="0,10,0,0" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{DynamicResource S_RoutingView_015}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource S_RoutingView_016}" Command="{Binding CloseRuleDialogCommand}" Padding="18,9" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource S_RoutingView_017}" Command="{Binding ConfirmAddRuleCommand}" Padding="22,9"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ===== geo-tag browser ===== -->
        <Border Panel.ZIndex="60" Background="#B3060410" Visibility="{Binding ShowGeoBrowser, Converter={StaticResource BoolVis}}">
            <Border Width="360" MaxHeight="560" VerticalAlignment="Center" HorizontalAlignment="Center" CornerRadius="16"
                    Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="18">
                <DockPanel>
                    <Grid DockPanel.Dock="Top">
                        <TextBlock Text="{DynamicResource S_RoutingView_018}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource GlyphButton}" Content="&#xE8BB;" Command="{Binding CloseGeoBrowserCommand}"/>
                    </Grid>
                    <TextBox DockPanel.Dock="Top" Style="{StaticResource DarkTextBox}" Margin="0,12,0,10"
                             Text="{Binding GeoQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding GeoTags}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button HorizontalContentAlignment="Left" Cursor="Hand" Margin="0,0,0,2"
                                            Command="{Binding DataContext.PickGeoTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="10,7">
                                                    <TextBlock Text="{Binding}" FontSize="12.5"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#18FFFFFF"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- ===== profile sheet =====
             What "⋮" opens on the phone: a panel up from the bottom with the profile's name, the
             line saying what it does, the actions with their icons, and — for a subscription's
             profile — the note explaining why editing is not among them. -->
        <Border Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="80" Background="#99060410"
                Visibility="{Binding IsSheetOpen, Converter={StaticResource BoolVis}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseRoutingSheetCommand}"/>
            </Border.InputBindings>
            <Border VerticalAlignment="Bottom" Background="{StaticResource Card}" CornerRadius="18,18,0,0"
                    BorderBrush="{StaticResource BorderSoft}" BorderThickness="1,1,1,0" Padding="0,10,0,18">
                <StackPanel>
                    <Border Width="34" Height="4" CornerRadius="2" Background="{StaticResource BorderSoft}"
                            HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <StackPanel Margin="20,0,20,10">
                        <TextBlock Text="{Binding SheetTitle}" FontSize="15" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SheetSubtitle}" Foreground="{StaticResource TextSecondary}"
                                   FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Style="{StaticResource SheetItem}" Tag="&#xE70F;" Content="{DynamicResource S_Routing_Edit}"
                            Visibility="{Binding SheetEditable, Converter={StaticResource BoolVis}}"
                            Command="{Binding SheetEditCommand}"/>
                    <Button Style="{StaticResource SheetItem}" Tag="&#xE8C8;" Content="{DynamicResource S_Routing_Duplicate}"
                            Command="{Binding SheetDuplicateCommand}"/>
                    <Button Style="{StaticResource SheetItem}" Tag="&#xE72D;" Content="{DynamicResource S_Routing_Export}"
                            Command="{Binding SheetExportCommand}"/>

                    <StackPanel Visibility="{Binding SheetEditable, Converter={StaticResource BoolVis}}">
                        <Border Height="1" Background="{StaticResource BorderSoft}" Margin="14,6"/>
                        <Button Style="{StaticResource SheetItem}" Tag="&#xE74D;" Content="{DynamicResource S_Routing_Delete}"
                                Foreground="{StaticResource Danger}" Command="{Binding SheetDeleteCommand}"/>
                    </StackPanel>

                    <TextBlock Text="{DynamicResource S_Routing_ReadOnly}" Foreground="{StaticResource TextMuted}"
                               FontSize="11.5" TextWrapping="Wrap" Margin="20,6,20,0"
                               Visibility="{Binding SheetReadOnly, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
            </Border>
        </Border>

    </Grid>
</UserControl>
