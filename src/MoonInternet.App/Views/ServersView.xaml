<UserControl x:Class="MoonInternet.App.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:MoonInternet.App">
    <Grid Margin="16,14,16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>    <!-- add / paste -->
            <RowDefinition Height="Auto"/>    <!-- search -->
            <RowDefinition Height="Auto"/>    <!-- protocol filter -->
            <RowDefinition Height="Auto"/>    <!-- sort -->
            <RowDefinition Height="*"/>       <!-- list -->
        </Grid.RowDefinitions>

        <!-- header -->
        <Grid Grid.Row="0" Margin="0,2,0,12">
            <StackPanel>
                <TextBlock Text="{DynamicResource S_ServersView_001}" FontSize="21" FontWeight="Bold"/>
                <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0"
                           Text="{Binding TotalServersText, Mode=OneWay}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource GlyphButton}" Width="34" Height="34" Content="&#xEC4A;"
                        Command="{Binding PingAllCommand}"/>
                <Button Style="{StaticResource GlyphButton}" Width="34" Height="34" Content="&#xE72C;"
                        Command="{Binding RefreshAllCommand}"/>
            </StackPanel>
        </Grid>

        <!-- add / paste -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource PrimaryButton}" Command="{Binding OpenAddDialogCommand}" Margin="0,0,4,0" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="{DynamicResource S_ServersView_004}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding PasteImportCommand}" Margin="4,0,0,0" Padding="14,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE77F;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock Text="{DynamicResource S_Paste_Long}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- search -->
        <Border Grid.Row="2" CornerRadius="11" Background="{StaticResource Card}" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="13,0,0,0"/>
                <Grid Grid.Column="1">
                    <TextBlock Text="{DynamicResource S_ServersView_006}" Foreground="{StaticResource TextMuted}" FontSize="13.5" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><DataTrigger Binding="{Binding Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource TextPrimary}"
                             VerticalContentAlignment="Center" FontSize="13.5" Padding="12,9"/>
                </Grid>
            </Grid>
        </Border>

        <!-- protocol filter -->
        <StackPanel Grid.Row="3" Margin="0,0,0,8">
            <TextBlock Text="{DynamicResource S_ServersView_007}" Foreground="{StaticResource SectionLabel}" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,6"/>
            <!-- "Все" + only the protocols that actually exist — one ItemsControl so chips flow/wrap naturally -->
            <ItemsControl ItemsSource="{Binding FilterChips}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Style="{StaticResource Chip}" GroupName="filt" Content="{Binding}" Margin="0,0,8,8" Checked="Chip_Checked">
                            <RadioButton.IsChecked>
                                <MultiBinding Converter="{StaticResource Eq}" Mode="OneWay">
                                    <Binding Path="DataContext.Filter" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    <Binding/>
                                </MultiBinding>
                            </RadioButton.IsChecked>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- sort -->
        <StackPanel Grid.Row="4" Margin="0,0,0,8">
            <TextBlock Text="{DynamicResource S_ServersView_008}" Foreground="{StaticResource SectionLabel}" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,6"/>
            <WrapPanel>
                <RadioButton Style="{StaticResource Chip}" GroupName="sort" Content="{DynamicResource S_ServersView_009}" Margin="0,0,8,8" Command="{Binding SetSortCommand}" CommandParameter="default" IsChecked="{Binding IsSortDefault, Mode=OneWay}"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="sort" Content="{DynamicResource S_ServersView_010}" Margin="0,0,8,8" Command="{Binding SetSortCommand}" CommandParameter="ping" IsChecked="{Binding IsSortPing, Mode=OneWay}"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="sort" Content="{DynamicResource S_ServersView_011}" Margin="0,0,8,8" Command="{Binding SetSortCommand}" CommandParameter="name" IsChecked="{Binding IsSortName, Mode=OneWay}"/>
                <RadioButton Style="{StaticResource Chip}" GroupName="sort" Content="{DynamicResource S_ServersView_012}" Margin="0,0,0,8" Command="{Binding SetSortCommand}" CommandParameter="favorite" IsChecked="{Binding IsSortFavorite, Mode=OneWay}"/>
            </WrapPanel>
        </StackPanel>

        <!-- subscription groups (scroll, no visible scrollbar, wheel handled in code-behind) -->
        <ScrollViewer Grid.Row="5" x:Name="ListScroll" VerticalScrollBarVisibility="Hidden" PreviewMouseWheel="ListScroll_PreviewMouseWheel">
            <ItemsControl ItemsSource="{Binding Subscriptions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="14" Background="#120C24" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- header: collapse area + actions -->
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding ToggleCollapseServersCommand}" Cursor="Hand" HorizontalContentAlignment="Stretch">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="hb" Background="Transparent" CornerRadius="14" Padding="14,12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" x:Name="chev" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,11,0"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SubMeter}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hb" Property="Background" Value="#10FFFFFF"/></Trigger>
                                                    <DataTrigger Binding="{Binding IsCollapsedServers}" Value="True"><Setter TargetName="chev" Property="Text" Value="&#xE76C;"/></DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Border Background="{StaticResource Accent}" CornerRadius="9" Padding="8,2" VerticalAlignment="Center" Margin="0,0,4,0" Visibility="{Binding DataContext.ShowServerCount, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{Binding Count}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                        <Grid Width="30" Height="28">
                                                    <!-- hidden while the spinner runs, or the two draw on top of each other -->
                                                    <Button Style="{StaticResource GlyphButton}" Width="30" Height="28" FontSize="13" Content="&#xEC4A;"
                                                Visibility="{Binding NotPinging, Converter={StaticResource BoolVis}}"
                                                Command="{Binding DataContext.PingSubscriptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                    <Ellipse Width="13" Height="13" StrokeThickness="2" Stroke="{StaticResource AccentText}" StrokeDashArray="3 2"
                                                             RenderTransformOrigin="0.5,0.5" IsHitTestVisible="False"
                                                             Visibility="{Binding Pinging, Converter={StaticResource BoolVis}}">
                                                        <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                                                        <Ellipse.Triggers>
                                                            <EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
                                                            </Storyboard></BeginStoryboard></EventTrigger>
                                                        </Ellipse.Triggers>
                                                    </Ellipse>
                                                </Grid>
                                        <Button Style="{StaticResource GlyphButton}" Width="30" Height="28" FontSize="13" Content="&#xE72C;"
                                                Command="{Binding DataContext.RefreshSubscriptionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        <Button Style="{StaticResource GlyphButton}" Width="30" Height="28" FontSize="13" Content="&#xE712;"
                                                Command="{Binding DataContext.OpenSubSheetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- announcement banner (gated by the "Показывать шапку подписки" setting) -->
                                <Border Margin="12,0,12,10" CornerRadius="10" Background="#1E1440" BorderBrush="#33B9A7FF" BorderThickness="1" Padding="12,10">
                                    <Border.Visibility>
                                        <MultiBinding Converter="{StaticResource AllVis}">
                                            <Binding Path="HasAnnouncement"/>
                                            <Binding Path="DataContext.ShowSubHeader" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </Border.Visibility>
                                    <TextBlock Text="{Binding Announcement}" Foreground="#CFC7EC" FontSize="11.5" TextWrapping="Wrap" LineHeight="17"/>
                                </Border>

                                <!-- servers -->
                                <ItemsControl Visibility="{Binding IsExpandedServers, Converter={StaticResource BoolVis}}" Margin="7,0,7,7"
                                              ItemsSource="{Binding ServersView}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="12" Padding="14,11" Margin="0,3" Cursor="Hand" BorderThickness="1">
                                                <Border.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick"
                                                                  Command="{Binding DataContext.SelectServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  CommandParameter="{Binding}"/>
                                                </Border.InputBindings>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource Card}"/>
                                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource CardHover}"/></Trigger>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                                <Setter Property="Background" Value="#251A44"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ServerRowTemplate}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
