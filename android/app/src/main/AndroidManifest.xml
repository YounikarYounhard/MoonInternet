<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Updating from GitHub. Android still shows its own installer and asks the user; this only
         lets us be the app that offers the file. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!--
        Which apps go through the tunnel is a list of apps, so we have to be able to see them.
        Since Android 11 an app cannot: it is shown only packages it declares an interest in, and
        without this the per-app page listed the ones that ship with the system and nothing the
        user had installed. It looked like a phone-versus-tablet difference, and was really an
        Android-version one.

        Asking for everything that can be launched, rather than the QUERY_ALL_PACKAGES permission,
        because that is exactly the question being asked and the permission is a restricted one.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>

    <application
        android:name=".MoonApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Moon">

        <receiver
            android:name=".vpn.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                       android:resource="@xml/update_paths"/>
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.Moon">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Long-press on the quick-settings tile. Without this filter Android has nothing of
                 ours to open and falls back to the system "App info" page, which is not what
                 anybody holding a VPN tile is reaching for. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <!-- import a server/subscription by tapping a share link -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="vless"/>
                <data android:scheme="vmess"/>
                <data android:scheme="trojan"/>
                <data android:scheme="ss"/>
                <data android:scheme="hysteria2"/>
                <data android:scheme="hy2"/>
                <data android:scheme="wireguard"/>
                <!-- what the Amnezia client actually hands out; "wireguard" alone caught nothing -->
                <data android:scheme="vpn"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.ScanQrActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.Moon"/>

        <!-- The tunnel itself. VpnService must declare this permission + intent filter. -->
        <service
            android:name=".vpn.MoonVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService"/>
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN tunnel kept alive while connected"/>
        </service>

        <!-- Quick Settings tile: connect straight from the notification shade -->
        <service
            android:name=".vpn.MoonTileService"
            android:exported="true"
            android:icon="@drawable/ic_moon"
            android:label="Moon Internet"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>

    </application>
</manifest>
