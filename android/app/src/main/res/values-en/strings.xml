    <string name="settingsscreen_150">"Moon Internet is a local VPN client. Below is how the app handles your data."</string>
    <string name="settingsscreen_151">"We collect nothing"</string>
    <string name="settingsscreen_152">"The app runs on your device. The developer receives none of your data: "</string>
    <string name="settingsscreen_153">"no accounts, no telemetry, no analytics, no calls home."</string>
    <string name="settingsscreen_154">"Data on your device"</string>
    <string name="settingsscreen_155">"Subscriptions, the server list, keys and access passwords are stored locally in the "</string>
    <string name="settingsscreen_156">"app’s own storage and never leave the phone. Uninstalling deletes them."</string>
    <string name="settingsscreen_157">"Your traffic"</string>
    <string name="settingsscreen_158">"Traffic goes through servers you added yourself (via a subscription link). "</string>
    <string name="settingsscreen_159">"Their operators handle traffic under their own rules — read their policy. "</string>
    <string name="settingsscreen_160">"The app itself does not log your traffic and does not forward it anywhere."</string>
    <string name="settingsscreen_161">"Network requests"</string>
    <string name="settingsscreen_162">"The app contacts only: (1) your subscription URLs — to fetch the server "</string>
    <string name="settingsscreen_163">"list; (2) geo-rule sources (GitHub, for example) — to download routing "</string>
    <string name="settingsscreen_164">"files when routing is on. Nowhere else."</string>
    <string name="settingsscreen_165">"Logs"</string>
    <string name="settingsscreen_166">"Technical logs for connection diagnostics are kept locally and never sent."</string>
    <string name="settingsscreen_167">"Privileges"</string>
    <string name="settingsscreen_168">"The app needs permission to create a VPN connection — Android asks for it "</string>
    <string name="settingsscreen_169">"once. It is used only to route traffic and collects nothing."</string>
    <string name="settingsscreen_170">"Changes"</string>
    <string name="settingsscreen_171">"This policy may be updated along with the app."</string>
    <string name="settingsscreen_172">"Moon Internet is provided “as is”, without any warranty. The app is "</string>
    <string name="settingsscreen_173">"only a tool for connecting to proxy/VPN servers that you add yourself."</string>
    <string name="settingsscreen_174">"You are responsible for the servers and subscriptions you use, and for obeying "</string>
    <string name="settingsscreen_175">"the laws of your country. The developer provides no proxy service and takes no "</string>
    <string name="settingsscreen_176">"responsibility for the contents of your traffic."</string>
    <string name="settingsscreen_177">"By using the app you agree to these terms."</string>
